{
  "Logging": {
	"LogLevel": {
	  "Default": "Information",
	  "Microsoft.AspNetCore": "Warning"
	}
  },
  "AllowedHosts": "*",

  "Serilog": {
	"MinimumLevel": {
	  "Override": {
		"Microsoft.AspNetCore.Hosting": "Warning",
		"Microsoft.AspNetCore.Mvc": "Warning",
		"Microsoft.AspNetCore.Routing": "Warning"
	  }
	}
  },

  "ApiSettings": {
	"CorrelationName": "X-Correlation-ID",
	"Name": "Auth API",
	"Version": "v1.0.0",
	"MaxPageSize": 12
  },

  "OpenTelemetry":{
	"ServiceName": "Book.Auth.Service",
	"ActivitySourceName": "ActivitySource.Auth.Api",
	"ServiceVersion": "1.0.0",
	"Endpoint": "http://localhost:4317",
	"IsUseConsole": false
  },

  "ConnectionStrings": {
	"UsersDB": "Server=localhost;Port=33006;Database=UsersDB;"
  },

  "Redis": {
	"Configuration": "localhost:6379",
	"InstanceName": "BooksTest"
  }
}