{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },

  "ReverseProxy": {
	"Swagger": {
	  "IsCommonDocument": false,
	  "CommonDocumentName": "YARP"
	},
	"Routes": {
	  "books-route": {
		"ClusterId": "books-cluster",
		"Match": {
		  "Path": "/api/{version:regex(([v,V])[0-9]{{1,3}})}/books/{**catch-all}"
		},
		"Transforms": [
		  { "RequestHeader": "X-Forwarded-Host", "Append": "{Host}" },
		  { "RequestHeader": "X-Request-Id", "Set": "{Random}" },
		  { "ResponseHeader": "X-Proxy-Server", "Set": "YARP", "When": "Always" }
		]
	  },
	  "users-login-route1": {
		"Order": 1,
		"ClusterId": "users-cluster",
		"RateLimiterPolicy": "fixed",
		"Match": {
		  "Path": "/api/users/login/{**catch-all}"
		},
		"Transforms": [
		  { "PathPattern": "/users/login/{**catch-all}" }
		]
	  },
	  "users-login-route2": {
		"Order": 2,
		"ClusterId": "users-cluster",
		"RateLimiterPolicy": "fixed",
		"Match": {
		  "Path": "/api/login/{**catch-all}"
		},
		"Transforms": [
		  { "PathPattern": "/users/login/{**catch-all}" }
		]
	  },
	  "users-route": {
		"Order": 10,
		"ClusterId": "users-cluster",
		"AuthorizationPolicy": "authenticated",
		"RateLimiterPolicy": "fixed",
		"Match": {
		  "Path": "/api/users/{**catch-all}"
		},
		"Transforms": [
		  { "PathPattern": "/users/{**catch-all}" }
		]
	  },
	  "notification-route": {
		"ClusterId": "notification-cluster",
		"RateLimiterPolicy": "fixed",
		"Match": {
		  "Path": "/notify/{**catch-all}"
		},
		"Transforms": [
		  { "PathPattern": "{**catch-all}" }
		]
	  }
	},
	"Clusters": {
	  "books-cluster": {
		"LoadBalancingPolicy": "RoundRobin",
		"HealthCheck": {
		  "Active": {
			"Enabled": false,
			"Interval": "00:00:10",
			"Timeout": "00:00:05",
			"Policy": "ConsecutiveFailures",
			"Path": "/healthz"
		  },
		  "Passive": {
			"Enabled": false,
			"Policy": "TransportFailureRate",
			"ReactivationPeriod": "00:02:00"
		  }
		},
		"Destinations": {
		  "books1": {
			"Address": "http://localhost:7119/",
			"Swaggers": [
			  {
				"MetadataPath": "/swagger/v1/swagger.json",
				"Paths": [
				  "/swagger/v1/swagger.json"
				]
			  },
			  {
				"MetadataPath": "/swagger/v2/swagger.json",
				"Paths": [
				  "/swagger/v2/swagger.json"
				]
			  }
			]
		  },
		  "books2": {
			"Address": "http://localhost:7119/"
		  }
		},
		"Metadata": {
		  "Swagger": "v1,v2"
		}
	  },
	  "users-cluster": {
		"HealthCheck": {
		  "Active": {
			"Enabled": false,
			"Interval": "00:00:10",
			"Timeout": "00:00:05",
			"Policy": "ConsecutiveFailures",
			"Path": "/healthz"
		  },
		  "Passive": {
			"Enabled": false,
			"Policy": "TransportFailureRate",
			"ReactivationPeriod": "00:02:00"
		  }
		},
		"Destinations": {
		  "destination1": {
			"Address": "http://localhost:7219/",
			"Swaggers": [
			  {
				"PrefixPath": "/api",
				"MetadataPath": "/swagger/v1/swagger.json",
				"Paths": [
				  "/swagger/v1/swagger.json"
				]
			  }
			]
		  }
		}
	  },
	  "notification-cluster": {
		"HealthCheck": {
		  "Active": {
			"Enabled": false,
			"Interval": "00:00:10",
			"Timeout": "00:00:05",
			"Policy": "ConsecutiveFailures",
			"Path": "/healthz"
		  },
		  "Passive": {
			"Enabled": false,
			"Policy": "TransportFailureRate",
			"ReactivationPeriod": "00:02:00"
		  }
		},
		"Destinations": {
		  "destination1": {
			"Address": "http://localhost:7019/",
			"Swaggers": [
			  {
				"PrefixPath": "/notify",
				"MetadataPath": "/swagger/v1/swagger.json",
				"Paths": [
				  "/swagger/v1/swagger.json"
				]
			  }
			]
		  }
		}
	  }
	}
  }
}
