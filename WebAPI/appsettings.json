{
  "AllowedHosts": "*",

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ApiSettings": {
	"CorrelationName": "X-Correlation-ID",
	"Name": "Books API",
	"Version": "v1.0.0",
	"MaxPageSize": 12
  },

  "Serilog": {
	"MinimumLevel": {
	  "Override": {
		"Microsoft.AspNetCore.Hosting": "Warning",
		"Microsoft.AspNetCore.Mvc": "Warning",
		"Microsoft.AspNetCore.Routing": "Warning"
	  }
	}
  },

  "ConnectionStrings": {
	"DefaultConnection": "Server=localhost;Port=33006;Database=BooksDB;User Id=root;Password=root;"
  },

  "NotificationApiSettings": {
	"BaseUrl": "http://localhost:7019"
  },

  "Redis": {
	"Configuration": "localhost:6379",
	"InstanceName": "BooksTest"
  },

  "OpenTelemetry":{
	"ServiceName": "Book.Books.Service",
	"ActivitySourceName": "ActivitySource.Books.Api",
	"ServiceVersion": "1.0.0",
	"Endpoint": "http://localhost:4317",
	"IsUseConsole": false
  }
}
